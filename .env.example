# Copie este arquivo para .env na VPS e troque todas as senhas.
MYSQL_DATABASE=conectacampus
MYSQL_USER=conecta_app
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-forte

# Acesso do DBeaver por tunel SSH, sem publicar o MySQL na internet.
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3307

# Com Nginx ou outro proxy reverso, mantenha 127.0.0.1.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_BASE_URL=https://seu-dominio.com.br
TZ=America/Manaus

# Integrações opcionais.
GOOGLE_SHEETS_FINANCEIRO_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=STARTTLS
