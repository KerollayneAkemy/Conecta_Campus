<div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-box confirm-neutro" id="confirmBox">
        <span class="confirm-icon" id="confirmIcon"><i class="bi bi-exclamation-lg" aria-hidden="true"></i></span>
        <h2 class="confirm-title" id="confirmTitle">Confirmar ação</h2>
        <p class="confirm-message" id="confirmMessage">Tem certeza que deseja continuar?</p>
        <div class="confirm-actions">
            <button type="button" class="btn btn-outline-secondary" id="confirmCancelar">Cancelar</button>
            <button type="button" class="btn btn-danger" id="confirmOk">Confirmar</button>
        </div>
    </div>
</div>